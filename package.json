{
  "name": "sponsor-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["apps/api"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:visual": "playwright test tests/visual-regression.spec.ts",
    "test:live": "playwright test tests/live-api.spec.ts",
    "test": "npm run typecheck && python3 scripts/validate_app.py && node scripts/smoke_ui.cjs && npm run test:api",
    "dev:api": "npm run dev --workspace @sponsor-studio/api",
    "build:api": "npm run build --workspace @sponsor-studio/api",
    "test:api": "npm run test --workspace @sponsor-studio/api",
    "db:generate": "npm run db:generate --workspace @sponsor-studio/api",
    "db:migrate": "npm run db:migrate --workspace @sponsor-studio/api",
    "db:deploy": "npm run db:deploy --workspace @sponsor-studio/api"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^27.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
